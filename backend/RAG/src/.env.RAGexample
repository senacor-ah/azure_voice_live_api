# ============================================================================
# Azure Blob Storage Configuration [REQUIRED]
# ============================================================================
# Azure Storage Account connection string for document storage
# Get from: Azure Portal -> Storage Account -> Access Keys -> Connection string
AZURE_STORAGE_CONNECTION_STRING=your_storage_connection_string_here

# Container name where PDF documents will be stored
AZURE_CONTAINER_NAME=pdfs

# ============================================================================
# Azure OpenAI Configuration [REQUIRED]
# ============================================================================
# Azure OpenAI API key for embeddings and chat completions
# Get from: Azure Portal -> Azure OpenAI Resource -> Keys and Endpoint
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here

# Azure OpenAI endpoint URL
# Format: https://YOUR-RESOURCE-NAME.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# API version for Azure OpenAI
# Recommended: 2024-12-01-preview or latest stable version
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Deployment name for embedding model (usually text-embedding-ada-002)
# This is the name you gave when deploying the model in Azure OpenAI Studio
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Deployment name for chat completion model (e.g., gpt-4, gpt-35-turbo)
# This is the name you gave when deploying the model in Azure OpenAI Studio
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini

# ============================================================================
# Azure Cognitive Search Configuration [REQUIRED]
# ============================================================================
# Azure AI Search service name (not the full URL, just the name)
# Get from: Azure Portal -> AI Search Resource -> Overview
AZURE_SEARCH_SERVICE_NAME=your_search_service_name

# Name for the search index (will be created automatically if it doesn't exist)
AZURE_SEARCH_INDEX_NAME=documents-index

# Azure AI Search admin API key
# Get from: Azure Portal -> AI Search Resource -> Keys
AZURE_SEARCH_API_KEY=your_search_api_key_here

# ============================================================================
# Setup Instructions
# ============================================================================
# 1. Copy this file to .env in the project root directory
# 2. Replace all placeholder values with your actual Azure credentials
# 3. Ensure .env is added to .gitignore to keep credentials secure
# 4. Verify all Azure resources are created and accessible
#
# Required Azure Resources:
# - Azure Storage Account with Blob Service
# - Azure OpenAI Service with deployed embedding and chat models
# - Azure AI Search Service
# ============================================================================
